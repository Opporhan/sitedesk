# Supabase panelinden: Project Settings → API
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxxxxxxx
# GİZLİ — kimseyle paylaşma, NEXT_PUBLIC_ ile başlatma. Project Settings → API Keys → Secret keys
SUPABASE_SECRET_KEY=sb_secret_xxxxxxxx
# GİZLİ — Supabase hesap erişim anahtarı (sadece veritabanı aracı için; izin: Veritabanı okuma/yazma)
# supabase.com/dashboard/account/tokens
SUPABASE_ACCESS_TOKEN=sbp_xxxxxxxx
# GİZLİ — Vercel'de de olmalı: zamanlanmış işlerin (yedek, temizlik, sağlık) anahtarı (en az 16 karakter)
CRON_SECRET=xxxxxxxx
# GİZLİ — bulut yedeğinin şifreleme anahtarı (32 bayt, base64). KAYBOLURSA YEDEK AÇILAMAZ; hiçbir yere yazma
BACKUP_KEY=xxxxxxxx
# Vercel Blob deposunun anahtarı (Vercel bağlayınca kendiliğinden eklenir)
BLOB_READ_WRITE_TOKEN=xxxxxxxx
# Deneme hesaplarının şifreleri (scripts/demo-mobil.mjs)
DEMO_YONETICI_SIFRE=xxxxxxxx
DEMO_DANISMA_SIFRE=xxxxxxxx
DEMO_SAKIN_SIFRE=xxxxxxxx
